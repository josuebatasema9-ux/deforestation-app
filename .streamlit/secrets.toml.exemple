# MODÈLE de fichier de secrets (ce fichier ne contient AUCUNE vraie clé).
#
# Usage :
#  - En local : copiez ce fichier sous le nom  .streamlit/secrets.toml
#    et remplacez les valeurs par celles de votre compte de service.
#  - En ligne (Streamlit Cloud) : collez ce contenu (avec les vraies valeurs) dans
#    l'application -> Settings -> Secrets. Ne le mettez JAMAIS sur GitHub.
#
# Le compte de service est créé dans Google Cloud (IAM -> Comptes de service) ;
# la clé JSON téléchargée contient ces champs. Le projet doit être enregistré
# pour Earth Engine et le compte de service autorisé à l'utiliser.

[earthengine]
type = "service_account"
project_id = "votre-projet-google-cloud"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n"
client_email = "nom-du-compte@votre-projet-google-cloud.iam.gserviceaccount.com"
client_id = "000000000000000000000"
token_uri = "https://oauth2.googleapis.com/token"
